# Server-only: supply values through environment settings. Never commit real keys.
GROQ_API_KEY=
CAREERMAP_AI_PROVIDER=groq
CAREERMAP_AI_MODEL=openai/gpt-oss-120b

# Local development defaults to sqlite; Vercel requires turso.
# Server-only: configure the real values in Vercel's environment settings.
# CAREERMAP_DATABASE_PROVIDER=turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Server-only administrator: register the owner account before setting this.
# Never use NEXT_PUBLIC_ or commit the actual owner email/ID.
IEUM_ADMIN_EMAIL=
# Optional: prefer an existing immutable user ID when supplied by the operator.
# IEUM_ADMIN_USER_ID=
